REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=dev-secret-key-that-is-at-least-32-chars-long-abc123xyz
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=majadigi
MINIO_USE_SSL=false
