NODE_ENV=development
LOG_LEVEL=debug

GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

AUTH_SERVICE_PORT=3001
BAPENDA_SERVICE_PORT=3002
# ... dst

DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=
DB_NAME=majadigi_main
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}


REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=dev-secret-key-that-is-at-least-32-chars-long-abc123xyz
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=majadigi
MINIO_USE_SSL=false
